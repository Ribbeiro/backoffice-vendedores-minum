# Nunca versionar um token real neste arquivo.
# Para producao, configure o segredo com:
# firebase functions:secrets:set MAPBOX_ACCESS_TOKEN

# Habilite apenas se a conta Mapbox estiver autorizada a armazenar resultados
# permanentes de geocodificacao. Caso contrario, as coordenadas ficam pendentes
# para revisao, sem quebrar a importacao.
MAPBOX_GEOCODING_PERMANENT=false

# Configuracao nao secreta da sincronizacao Odoo.
# Copie para functions/.env no ambiente de deploy e preencha somente depois de
# confirmar a API exposta pelo Odoo/proxy. Nunca inclua ODOO_API_KEY neste arquivo.
ODOO_SYNC_ENABLED=false
ODOO_SYNC_MAX_EVENTS=20
ODOO_BASE_URL=<URL_CONFIRMADA_DO_ODOO>
ODOO_PROTOCOL=json2
ODOO_DATABASE=<BANCO_SE_NECESSARIO>
ODOO_LOGIN=<LOGIN_SE_NECESSARIO_PARA_JSONRPC>
ODOO_CRM_LEAD_MODEL_ID=<ID_DE_IR_MODEL_CRM_LEAD>
ODOO_ACTIVITY_TYPE_ID=<ID_DO_TIPO_DE_ATIVIDADE>
ODOO_DEFAULT_USER_ID=<ID_DO_USUARIO_RESPONSAVEL_OPCIONAL>
