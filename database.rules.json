{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "customers": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "leadImportJobs": {
      ".write": false,
      ".indexOn": ["expiresAt"],
      "$jobId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.child('createdBy').val() === auth.uid"
      }
    },
    "leadImportCache": {
      ".read": false,
      ".write": false
    },
    "plannedRoutes": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && query.orderByChild === 'sellerUid' && query.equalTo === auth.uid))",
      ".indexOn": ["sellerUid"],
      ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true"
    },
    "plannedRouteStops": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$routeId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && root.child('plannedRoutes').child($routeId).child('sellerUid').val() === auth.uid"
      },
      ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true"
    },
    "sharedRoutesBySeller": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$routeId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "status": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'in_progress' || newData.val() === 'completed' || newData.val() === 'not_completed')"
              },
          "isCompleted": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isBoolean()"
          },
          "startedAt": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
          },
          "completedAt": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
          },
              "updatedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "notCompletedReason": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "stops": {
            "$stopId": {
              "status": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'visited' || newData.val() === 'not_visited')"
              },
              "result": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'visited' || newData.val() === 'not_visited')"
              },
              "wasVisited": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isBoolean()"
              },
              "feedback": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isString()"
              },
              "feedbackAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "visitedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLatitude": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLongitude": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLocation": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.hasChildren(['latitude', 'longitude'])"
              },
              "feedbackAccuracyMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "feedbackDistanceToCustomerMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "notVisitedReason": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "commercialOutcome": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "nextAction": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "nextActionDueDate": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "checkInAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "checkInLocation": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.hasChildren(['latitude', 'longitude'])"
              },
              "checkInDistanceToCustomerMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "checkOutAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "updatedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              }
            }
          }
        }
      }
    },
    "visitEvents": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$routeId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$stopId": {
          "$eventId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && !data.exists() && newData.child('sellerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['id', 'routeId', 'stopId', 'sellerUid', 'eventType', 'location', 'createdAt']) && newData.child('id').val() === $eventId && newData.child('routeId').val() === $routeId && newData.child('stopId').val() === $stopId && newData.child('sellerUid').val() === auth.uid && (newData.child('eventType').val() === 'route_started' || newData.child('eventType').val() === 'route_progress' || newData.child('eventType').val() === 'stop_arrived' || newData.child('eventType').val() === 'check_in' || newData.child('eventType').val() === 'feedback_submitted' || newData.child('eventType').val() === 'check_out' || newData.child('eventType').val() === 'stop_departed' || newData.child('eventType').val() === 'route_finished') && newData.child('location').hasChildren(['latitude', 'longitude']) && newData.child('location').child('latitude').isNumber() && newData.child('location').child('longitude').isNumber() && newData.child('createdAt').isNumber()"
          }
        }
      }
    },
    "routeCreationLimits": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$day": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 5 && newData.child('limit').val() === 5 && newData.child('day').val() === $day) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    }
  }
}
