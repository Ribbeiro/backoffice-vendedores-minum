{
  "rules": {
    "odooSyncQueue": {
      ".read": false,
      ".write": false,
      ".indexOn": ["nextAttemptAt"]
    },
    "customersBySeller": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && root.child('users').child(auth.uid).child('allowedAccess').val() !== false && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "customers": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "leadImportJobs": {
      ".write": false,
      ".indexOn": ["expiresAt"],
      "$jobId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.child('createdBy').val() === auth.uid"
      }
    },
    "leadImportCache": {
      ".read": false,
      ".write": false
    },
    "plannedRoutes": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && query.orderByChild === 'sellerUid' && query.equalTo === auth.uid))",
      ".indexOn": ["sellerUid", "createdAt", "status"],
      ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true"
    },
    "plannedRouteStops": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$routeId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && root.child('plannedRoutes').child($routeId).child('sellerUid').val() === auth.uid"
      },
      ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true"
    },
    "sharedRoutesBySeller": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$routeId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "status": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'in_progress' || newData.val() === 'completed' || newData.val() === 'not_completed')"
              },
          "isCompleted": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isBoolean()"
          },
          "startedAt": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
          },
          "completedAt": {
            ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
          },
              "updatedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "notCompletedReason": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "stops": {
            "$stopId": {
              "status": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'visited' || newData.val() === 'not_visited')"
              },
              "result": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (newData.val() === 'visited' || newData.val() === 'not_visited')"
              },
              "wasVisited": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isBoolean()"
              },
              "feedback": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isString()"
              },
              "feedbackAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "visitedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLatitude": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLongitude": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "feedbackLocation": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.hasChildren(['latitude', 'longitude'])"
              },
              "feedbackAccuracyMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "feedbackDistanceToCustomerMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "notVisitedReason": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "commercialOutcome": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "nextAction": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "nextActionDueDate": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isString())"
              },
              "checkInAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "checkInLocation": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.hasChildren(['latitude', 'longitude'])"
              },
              "checkInDistanceToCustomerMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              },
              "checkOutAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "checkOutLocation": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.hasChildren(['latitude', 'longitude']))"
              },
              "checkOutDistanceToCustomerMeters": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "visitDurationSeconds": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && (!newData.exists() || newData.isNumber())"
              },
              "attendances": {
                "$attendanceId": {
                  ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.child('sellerUid').val() === auth.uid",
                  ".validate": "newData.hasChildren(['id', 'routeId', 'stopId', 'customerId', 'sellerUid', 'status', 'checkInAt', 'checkInLocation', 'checkInDistanceToCustomerMeters', 'updatedAt']) && newData.child('id').val() === $attendanceId && newData.child('routeId').val() === $routeId && newData.child('stopId').val() === $stopId && newData.child('sellerUid').val() === auth.uid && (newData.child('status').val() === 'in_progress' || newData.child('status').val() === 'awaiting_feedback' || newData.child('status').val() === 'visited' || newData.child('status').val() === 'not_visited') && newData.child('checkInAt').isNumber() && newData.child('checkInLocation').hasChildren(['latitude', 'longitude']) && newData.child('checkInLocation').child('latitude').isNumber() && newData.child('checkInLocation').child('longitude').isNumber() && newData.child('checkInDistanceToCustomerMeters').isNumber() && newData.child('updatedAt').isNumber()"
                }
              },
              "updatedAt": {
                ".write": "auth != null && auth.uid === $uid && root.child('sharedRoutesBySeller').child($uid).child($routeId).child('sellerUid').val() === auth.uid && newData.isNumber()"
              }
            }
          }
        }
      }
    },
    "visitEvents": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$routeId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()",
        "$stopId": {
          "$eventId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && !data.exists() && newData.child('sellerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['id', 'routeId', 'stopId', 'sellerUid', 'eventType', 'location', 'createdAt']) && newData.child('id').val() === $eventId && newData.child('routeId').val() === $routeId && newData.child('stopId').val() === $stopId && (newData.child('eventType').val() === 'route_started' || newData.child('eventType').val() === 'route_progress' || newData.child('eventType').val() === 'stop_arrived' || newData.child('eventType').val() === 'check_in' || newData.child('eventType').val() === 'feedback_submitted' || newData.child('eventType').val() === 'check_out' || newData.child('eventType').val() === 'stop_departed' || newData.child('eventType').val() === 'route_finished') && newData.child('location').hasChildren(['latitude', 'longitude']) && newData.child('location').child('latitude').isNumber() && newData.child('location').child('longitude').isNumber() && newData.child('createdAt').isNumber() && ((!data.exists() && newData.child('sellerUid').val() === auth.uid) || (data.exists() && newData.child('id').val() === data.child('id').val() && newData.child('routeId').val() === data.child('routeId').val() && newData.child('stopId').val() === data.child('stopId').val() && newData.child('sellerUid').val() === data.child('sellerUid').val() && newData.child('eventType').val() === data.child('eventType').val() && newData.child('location').child('latitude').val() === data.child('location').child('latitude').val() && newData.child('location').child('longitude').val() === data.child('location').child('longitude').val() && newData.child('createdAt').val() === data.child('createdAt').val())) && ((!newData.child('odooSyncStatus').exists() && !newData.child('odooRetryCount').exists() && !newData.child('odooOperation').exists() && !newData.child('odooLeadId').exists() && !newData.child('odooExternalId').exists() && !newData.child('minumCode').exists()) || (newData.child('odooRetryCount').val() === 0 && ((newData.child('eventType').val() === 'feedback_submitted' && ((newData.child('odooLeadId').isNumber() && newData.child('odooLeadId').val() === root.child('customers').child(newData.child('customerExternalId').val()).child('odooLeadId').val() && newData.child('odooSyncStatus').val() === 'pending' && newData.child('odooOperation').val() === 'create_activity') || (!newData.child('odooLeadId').exists() && newData.child('odooSyncStatus').val() === 'not_required' && !newData.child('odooOperation').exists()))) || (newData.child('eventType').val() !== 'feedback_submitted' && newData.child('odooSyncStatus').val() === 'not_required' && !newData.child('odooOperation').exists() && !newData.child('odooLeadId').exists())))))",
            "odooLeadId": {
              ".validate": "newData.isNumber() && newData.val() === root.child('customers').child(newData.parent().child('customerExternalId').val()).child('odooLeadId').val()"
            },
            "odooExternalId": {
              ".validate": "newData.val() === root.child('customers').child(newData.parent().child('customerExternalId').val()).child('odooExternalId').val()"
            },
            "minumCode": {
              ".validate": "newData.val() === root.child('customers').child(newData.parent().child('customerExternalId').val()).child('minumCode').val() || newData.val() === root.child('customers').child(newData.parent().child('customerExternalId').val()).child('externalId').val()"
            },
            "followUpStatus": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && (newData.val() === 'open' || newData.val() === 'in_progress' || newData.val() === 'completed')"
            },
            "followUpUpdatedAt": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.isNumber()"
            },
            "followUpUpdatedBy": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.val() === auth.uid"
            },
            "followUpUpdatedByName": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.isString()"
            },
            "followUpCompletedAt": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && (!newData.exists() || newData.isNumber())"
            },
            "followUpCompletedBy": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && (!newData.exists() || newData.val() === auth.uid)"
            }
          }
        }
      }
    },
    "routeCreationLimits": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$day": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('deleted').val() !== true && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 5 && newData.child('limit').val() === 5 && newData.child('day').val() === $day) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    }
  }
}
